{
  "name": "propai-selenium-tests",
  "version": "2.0.0",
  "description": "PropAI Web E2E Automation Framework - Selenium WebDriver (520 Test Cases)",
  "scripts": {
    "test": "mocha --config .mocharc.js --exit",
    "test:auth": "mocha tests/auth/*.spec.js --config .mocharc.js --exit",
    "test:dashboard": "mocha tests/dashboard/*.spec.js --config .mocharc.js --exit",
    "test:advanced": "mocha tests/advanced/*.spec.js --config .mocharc.js --exit",
    "test:uiux": "mocha tests/ui-ux/*.spec.js --config .mocharc.js --exit",
    "test:functional": "mocha tests/functional/*.spec.js --config .mocharc.js --exit",
    "test:validation": "mocha tests/validation/*.spec.js --config .mocharc.js --exit",
    "test:deployment": "mocha tests/deployment/*.spec.js --config .mocharc.js --exit",
    "test:all": "mocha \"tests/**/*.spec.js\" --config .mocharc.js --exit",
    "test:chrome": "cross-env BROWSER=chrome npm test",
    "test:firefox": "cross-env BROWSER=firefox npm test",
    "test:edge": "cross-env BROWSER=edge npm test",
    "test:headless": "cross-env HEADLESS=true npm test",
    "test:new-suites": "mocha \"tests/ui-ux/*.spec.js\" \"tests/functional/*.spec.js\" \"tests/validation/*.spec.js\" \"tests/deployment/*.spec.js\" --config .mocharc.js --exit",
    "report": "node utilities/excelReporter.js"
  },
  "dependencies": {
    "selenium-webdriver": "^4.21.0"
  },
  "devDependencies": {
    "mocha": "^10.4.0",
    "chai": "^4.4.1",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0",
    "exceljs": "^4.4.0",
    "winston": "^3.13.0",
    "dotenv": "^16.4.5",
    "uuid": "^10.0.0",
    "moment": "^2.30.1",
    "cross-env": "^7.0.3",
    "chromedriver": "*",
    "geckodriver": "^4.4.3"
  },
  "engines": { "node": ">=18.0.0" }
}
