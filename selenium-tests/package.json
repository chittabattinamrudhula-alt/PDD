{
  "name": "propai-selenium-tests",
  "version": "1.0.0",
  "description": "PropAI Web E2E Automation Framework - Selenium WebDriver",
  "scripts": {
    "test": "mocha --config .mocharc.js --exit",
    "test:auth": "mocha tests/auth/*.spec.js --config .mocharc.js --exit",
    "test:dashboard": "mocha tests/dashboard/*.spec.js --config .mocharc.js --exit",
    "test:properties": "mocha tests/properties/*.spec.js --config .mocharc.js --exit",
    "test:valuation": "mocha tests/valuation/*.spec.js --config .mocharc.js --exit",
    "test:ledger": "mocha tests/ledger/*.spec.js --config .mocharc.js --exit",
    "test:bookings": "mocha tests/bookings/*.spec.js --config .mocharc.js --exit",
    "test:profile": "mocha tests/profile/*.spec.js --config .mocharc.js --exit",
    "test:navigation": "mocha tests/navigation/*.spec.js --config .mocharc.js --exit",
    "test:chrome": "BROWSER=chrome npm test",
    "test:firefox": "BROWSER=firefox npm test",
    "test:edge": "BROWSER=edge npm test",
    "report": "node utilities/reportGenerator.js"
  },
  "dependencies": {
    "selenium-webdriver": "^4.21.0"
  },
  "devDependencies": {
    "mocha": "^10.4.0",
    "chai": "^4.4.1",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0",
    "exceljs": "^4.4.0",
    "winston": "^3.13.0",
    "dotenv": "^16.4.5",
    "uuid": "^10.0.0",
    "moment": "^2.30.1",
    "chromedriver": "^126.0.0",
    "geckodriver": "^4.4.3",
    "msedgedriver": "^126.0.0"
  },
  "engines": { "node": ">=18.0.0" }
}
