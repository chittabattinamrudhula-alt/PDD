# ─── Target URL ────────────────────────────────────────────────────────────────
# MANDATORY: Always use the LIVE GitHub Pages URL. Never localhost.
BASE_URL=https://chittabattinamrudhula-alt.github.io/PDD

# ─── Browser ───────────────────────────────────────────────────────────────────
BROWSER=chrome
HEADLESS=true

# ─── Timeouts (ms) ─────────────────────────────────────────────────────────────
IMPLICIT_WAIT=15000
EXPLICIT_WAIT=45000

# ─── Test Credentials (seed accounts) ─────────────────────────────────────────
TEST_BUYER_EMAIL=buyer@propai.com
TEST_BUYER_PASSWORD=password
TEST_SELLER_EMAIL=seller@propai.com
TEST_SELLER_PASSWORD=password
TEST_ADMIN_EMAIL=admin@propai.com
TEST_ADMIN_PASSWORD=password

# ─── Environment Metadata ──────────────────────────────────────────────────────
ENVIRONMENT=github-pages
GITHUB_RUN_NUMBER=1
GITHUB_SHA=local
GITHUB_REPO=chittabattinamrudhula-alt/PDD
