    "test:valuation": "mocha tests/valuation/*.spec.js --config .mocharc.js --exit",
    "test:ledger": "mocha tests/ledger/*.spec.js --config .mocharc.js --exit",
    "test:bookings": "mocha tests/bookings/*.spec.js --config .mocharc.js --exit",
    "test:profile": "mocha tests/profile/*.spec.js --config .mocharc.js --exit",
    "test:navigation": "mocha tests/navigation/*.spec.js --config .mocharc.js --exit",
